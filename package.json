{
  "name": "selector-strike",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --import tsx server/dev.ts",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "preview": "vite preview",
    "test:browser": "node --import tsx tests/invasion-story-browser.mjs",
    "format": "prettier --write src shared server api tests",
    "test:audit": "node tests/invasion-audit.mjs"
  },
  "dependencies": {
    "acorn": "^8.15.0",
    "jquery": "^3.7.1",
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/jquery": "^3.5.32",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.15.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.9.10",
    "tsx": "^4.20.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
